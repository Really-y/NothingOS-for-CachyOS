  <g id="body">
    <!-- shoulders, arms and midriff (skin), lit from the left -->
    <path fill="url(#skinBody)" d="M 280,404 L 320,404 C 324,428 350,440 400,448
      C 452,456 482,482 490,530 C 498,600 500,700 506,830 L 94,830 C 100,700 102,600 110,530
      C 118,482 148,456 200,448 C 250,440 276,428 280,404 Z"/>
    <path fill="none" stroke="#7a7a7a" stroke-width="5" stroke-linecap="round"
          d="M 288,440 C 264,448 238,452 212,456 M 312,440 C 336,448 362,452 388,456"/>
    <!-- gap between arms and torso -->
    <path fill="none" stroke="#4a4a4a" stroke-width="9" stroke-linecap="round"
          d="M 156,560 C 160,640 162,720 166,830 M 444,560 C 440,640 438,720 434,830"/>
    <!-- crop camisole: thin straps, straight modest neckline, ends above the waist -->
    <path fill="none" stroke="#262626" stroke-width="7" stroke-linecap="round" d="M 232,528 L 222,452 M 368,528 L 378,452"/>
    <path fill="#2a2a2a" d="M 170,540 C 204,522 250,528 300,532 C 350,528 396,522 430,540
      L 434,660 C 380,676 220,676 166,660 Z"/>
    <path fill="none" stroke="#808080" stroke-width="6" stroke-linecap="round"
          d="M 172,540 C 204,524 250,530 300,534 C 350,530 396,524 428,540"/>
    <path fill="none" stroke="#4a4a4a" stroke-width="6" stroke-linecap="round" d="M 168,656 C 220,672 380,672 432,656"/>
    <!-- midriff: soft centre shade, navel -->
    <ellipse cx="300" cy="712" rx="3.5" ry="5" fill="#6a6a6a"/>
    <!-- denim shorts waistband at the bottom edge -->
    <path fill="#3a3a3a" d="M 160,748 C 220,758 380,758 440,748 L 446,830 L 154,830 Z"/>
    <path fill="none" stroke="#666666" stroke-width="6" stroke-linecap="round" d="M 162,752 C 220,762 380,762 438,752"/>
    <circle cx="300" cy="772" r="5" fill="#999999"/>
  </g>
