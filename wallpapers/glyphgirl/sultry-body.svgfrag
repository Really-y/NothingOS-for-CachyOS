  <!-- ===== Sultry: three-quarter BACK view, canvas coordinates (make_sultry.py) =====
       Her left (viewer-left) side is near: sloped shoulder with a clear shoulder point, the arm
       bent slightly away so the waist shows against the background. Far (right) arm raised, the
       hand threaded into her hair at the back of the head; the length spills over the far
       shoulder and hangs beside the waist. Backless black satin gown: skin from the shoulders
       to the small of the back, the gown covers the sides from the armpits down.
       Light from the left (the desktop) -> rim group, kept below 0.97 so rim dots stay
       size-modulated (anti-aliased) instead of forced full dots.
       Values: face 0.83 is the brightest skin; back 0.76 -> 0.61 toward the waist; hair 0.28,
       strands 0.6; gown 0.34 (one clear step above the field) with ~0.5 sheen. -->
  <defs>
    <linearGradient id="skinBack" x1="0" y1="404" x2="0" y2="640" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#c2c2c2"/><stop offset="0.55" stop-color="#b0b0b0"/><stop offset="1" stop-color="#9c9c9c"/>
    </linearGradient>
    <linearGradient id="skinArm" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#cacaca"/><stop offset="1" stop-color="#aaaaaa"/>
    </linearGradient>
    <clipPath id="backClip"><path d="M 150,452 C 180,432 250,414 312,404 C 350,400 400,398 432,404 C 450,410 462,420 468,432
      C 458,480 440,540 420,600 L 420,660 L 215,660 L 215,600 C 206,560 196,516 184,470 C 176,460 164,454 150,452 Z"/></clipPath>
  </defs>

  <g id="hair-back">
    <!-- crown + back of the head (she is turned away), the bunch gathered from the nape into her hand -->
    <ellipse cx="302" cy="176" rx="88" ry="62" fill="#474747"/>
    <path fill="#474747" d="M 276,126 C 346,102 420,134 438,196 C 446,236 432,286 406,334
      C 392,338 376,336 364,330 L 350,190 Z"/>
    <path fill="#474747" d="M 364,330 C 386,290 408,248 430,206 L 464,214 C 450,256 426,298 400,336 Z"/>
    <!-- the gathered ends spill over the top of her hand -->
    <path fill="#474747" d="M 432,200 C 426,168 444,140 470,134 C 494,128 514,142 518,168
      C 508,156 492,152 480,160 C 468,168 464,184 468,202 Z"/>
    <g fill="none" stroke="#9a9a9a" stroke-linecap="round">
      <path stroke-width="6" d="M 444,190 C 444,164 458,146 482,142"/>
      <path stroke-width="7" d="M 340,122 C 390,122 422,158 426,206"/>
      <path stroke-width="6" d="M 378,318 C 394,284 410,250 428,216"/>
    </g>
    <path fill="none" stroke="#2a2a2a" stroke-width="6" stroke-linecap="round" d="M 394,326 C 410,290 426,254 446,220"/>
  </g>

  <g id="neck">
    <!-- side/back of the neck between jaw, skull and trapezius -->
    <path fill="#c2c2c2" d="M 318,372 C 336,350 356,322 372,300 C 390,316 404,326 416,330
      C 416,356 420,384 434,420 L 306,424 C 316,396 318,386 318,372 Z"/>
    <!-- tendon from behind the ear toward the (hidden) collarbone, and the nape groove -->
    <path fill="none" stroke="#9a9a9a" stroke-width="7" stroke-linecap="round" filter="url(#soft2)" d="M 374,312 C 360,344 344,376 330,404"/>
    <path fill="none" stroke="#e0e0e0" stroke-width="5" stroke-linecap="round" filter="url(#soft2)" d="M 384,318 C 372,348 360,376 348,404"/>
    <path fill="none" stroke="#a6a6a6" stroke-width="5" stroke-linecap="round" filter="url(#soft2)" d="M 404,342 C 402,364 400,384 398,406"/>
  </g>

  <g id="body">
    <!-- near arm (her left): deltoid, upper arm ~45 px, elbow bent slightly away at y~620,
         forearm back to the hip -> a background gap at the waist -->
    <path fill="url(#skinArm)" d="M 150,450 C 136,460 128,486 126,516 C 122,556 118,592 118,616
      C 118,634 126,644 138,646 C 150,644 158,636 162,624 C 166,590 170,546 176,506
      C 180,486 180,466 172,456 Z"/>
    <path fill="url(#skinArm)" d="M 120,624 C 128,680 150,732 172,782 L 206,772 C 188,724 172,676 162,626 Z"/>
    <path fill="#b4b4b4" d="M 170,776 C 176,792 190,800 206,800 L 214,800 C 214,786 210,774 204,768 Z"/>
    <!-- raised far arm (her right): deltoid, upper arm to the elbow, short foreshortened forearm, thin wrist -->
    <path fill="#bcbcbc" d="M 420,404 C 450,340 500,262 530,204 C 538,186 548,174 560,174
      C 572,176 576,190 570,204 C 556,252 522,334 476,438 C 462,424 444,410 420,404 Z"/>
    <path fill="#b4b4b4" d="M 558,174 C 538,178 514,184 494,190 L 492,212 C 512,212 536,210 558,206
      C 574,200 572,178 558,174 Z"/>
    <path fill="none" stroke="#9a9a9a" stroke-width="5" stroke-linecap="round" filter="url(#soft2)" d="M 470,420 C 496,356 524,290 552,222"/>
    <!-- bare back -->
    <path fill="url(#skinBack)" d="M 150,452 C 180,432 250,414 312,404 C 350,400 400,398 432,404 C 450,410 462,420 468,432
      C 458,480 440,540 420,600 L 420,660 L 215,660 L 215,600 C 206,560 196,516 184,470 C 176,460 164,454 150,452 Z"/>
    <g clip-path="url(#backClip)">
      <!-- spine: soft groove from the nape to the scoop, lit edge beside it -->
      <path fill="none" stroke="#949494" stroke-width="9" stroke-linecap="round" filter="url(#soft2)"
            d="M 392,410 C 372,460 358,520 354,560 C 352,588 352,606 352,626"/>
      <path fill="none" stroke="#d2d2d2" stroke-width="7" stroke-linecap="round" filter="url(#soft2)"
            d="M 378,414 C 360,462 346,520 342,560"/>
      <!-- near shoulder blade (medial edge + lower tip), far shoulder blade -->
      <path fill="#9c9c9c" filter="url(#soft)" d="M 318,436 C 324,474 312,514 282,536 C 266,546 248,544 240,536
        C 264,528 288,508 300,480 C 306,464 310,450 318,436 Z"/>
      <path fill="#9a9a9a" filter="url(#soft)" d="M 418,430 C 432,458 438,492 430,526 C 422,506 416,474 404,448 Z"/>
      <!-- lower back falls off into shadow toward the far side -->
      <path fill="#8e8e8e" filter="url(#soft)" d="M 380,560 C 400,540 418,520 430,500 L 430,660 L 360,660 Z"/>
    </g>
    <!-- backless satin gown: covers the sides from the armpits, scoops to the small of the back -->
    <path fill="#565656" d="M 184,470 C 214,546 286,612 352,622 C 400,614 438,548 466,436
      C 458,480 440,540 420,600 C 426,660 440,720 448,800 L 186,800 C 198,740 214,670 215,600
      C 206,560 196,516 184,470 Z"/>
    <!-- folds (>= 2 dots) between long vertical sheen strokes (~0.5) -->
    <g fill="none" stroke-linecap="round">
      <path stroke="#333333" stroke-width="11" d="M 262,640 C 270,690 270,746 264,800 M 338,648 C 350,700 356,750 360,800 M 392,630 C 404,690 410,744 418,800"/>
      <path stroke="#828282" stroke-width="9" filter="url(#soft2)" d="M 232,632 C 228,690 222,746 214,800"/>
      <path stroke="#7a7a7a" stroke-width="9" filter="url(#soft2)" d="M 300,646 C 306,700 310,752 312,800"/>
      <path stroke="#747474" stroke-width="8" filter="url(#soft2)" d="M 410,620 C 420,680 428,740 436,800"/>
    </g>
    <!-- 1-dot trim highlight along the scoop -->
    <path fill="none" stroke="#a8a8a8" stroke-width="4" stroke-linecap="round"
          d="M 188,478 C 220,550 288,614 352,620 C 398,612 436,548 462,446"/>
  </g>

  <g id="rim">
    <!-- soft core shadows just inside the lit edges -->
    <g fill="none" stroke-linecap="round" filter="url(#soft2)">
      <path stroke="#a0a0a0" stroke-width="10" clip-path="url(#backClip)" d="M 196,500 C 206,540 214,580 220,620"/>
      <path stroke="#a2a2a2" stroke-width="9" d="M 138,480 C 134,530 130,580 130,616"/>
    </g>
    <!-- light from the left, kept < 0.97 so the dots stay size-modulated -->
    <g fill="none" stroke="#f2f2f2" stroke-width="4.5" stroke-linecap="round">
      <!-- near shoulder, deltoid, upper arm, elbow, forearm -->
      <path d="M 300,406 C 250,414 194,428 162,444 C 142,456 130,484 127,516 C 123,556 119,592 119,616
        C 119,632 124,640 128,644 C 134,690 152,736 172,780"/>
      <!-- the waist gap, lit on both edges -->
      <path d="M 186,474 C 196,516 206,560 214,600 C 214,670 200,740 190,800"/>
      <path stroke="#e2e2e2" d="M 176,488 C 170,540 166,590 162,624 C 170,672 184,720 202,768"/>
      <!-- raised arm, elbow, forearm top to the wrist -->
      <path d="M 424,404 C 452,342 500,262 530,204 C 538,186 548,176 558,176 L 496,190"/>
    </g>
    <!-- far side: dimmer edge so the gown never merges with the field -->
    <path fill="none" stroke="#b8b8b8" stroke-width="4" stroke-linecap="round" d="M 466,440 C 456,490 440,546 422,600 C 428,660 442,720 448,800"/>
  </g>

  <g id="hair-curtain">
    <!-- the length spills from her hand over the far shoulder and hangs beside the waist -->
    <path fill="#474747" d="M 440,214 C 428,256 426,298 438,338 C 448,374 430,410 432,450
      C 434,490 452,520 446,560 C 442,590 448,616 458,642 C 466,624 472,608 474,592
      C 482,610 490,624 500,632 C 498,600 494,576 498,548 C 502,510 486,482 494,448
      C 500,414 506,378 494,340 C 484,306 488,264 490,222 Z"/>
    <g fill="none" stroke-linecap="round">
      <path stroke="#9a9a9a" stroke-width="6" d="M 450,232 C 440,272 438,304 450,338 C 460,372 442,410 444,450 C 446,490 462,520 458,560 C 456,586 458,606 462,624"/>
      <path stroke="#8c8c8c" stroke-width="6" d="M 478,240 C 476,280 480,310 484,340 C 490,376 476,412 478,450 C 480,486 490,516 486,560"/>
      <path stroke="#2a2a2a" stroke-width="5" d="M 464,232 C 458,276 460,308 466,340 C 472,376 458,412 460,452 C 462,494 470,530 470,590"/>
      <!-- 1-dot rim where the hair crosses the gown / background -->
      <path stroke="#8a8a8a" stroke-width="3.5" d="M 434,452 C 436,490 452,520 448,560 C 444,590 450,616 458,640"/>
      <path stroke="#7a7a7a" stroke-width="3.5" d="M 496,450 C 500,490 488,520 496,560 C 498,594 498,616 500,630"/>
    </g>
    <!-- loose tendrils at the nape -->
    <path fill="none" stroke="#666666" stroke-width="4.5" stroke-linecap="round" d="M 400,336 C 394,356 406,374 398,396 C 394,408 398,418 402,426"/>
    <path fill="none" stroke="#666666" stroke-width="4" stroke-linecap="round" d="M 414,340 C 412,360 422,378 416,400"/>
  </g>

  <g id="hand">
    <!-- back of her right hand; four separate fingers threaded up-left into the hair with
         dark gaps >= 1 dot (a shadow keeps them dark), thin wrist -->
    <path fill="#1c1c1c" d="M 434,156 C 452,162 470,172 482,180 L 482,226 C 466,232 448,232 430,230
      C 420,222 418,206 420,190 C 422,174 426,160 434,156 Z"/>
    <path fill="#c4c4c4" d="M 496,188 C 484,182 472,182 464,186 C 458,196 458,212 464,222
      C 474,226 486,222 496,214 Z"/>
    <g fill="none" stroke="#c4c4c4" stroke-width="8" stroke-linecap="round">
      <path d="M 468,188 C 458,180 448,172 438,164"/>
      <path d="M 464,198 C 452,194 440,188 428,184"/>
      <path d="M 464,208 C 452,208 440,206 428,204"/>
      <path d="M 466,218 C 456,222 446,224 436,224"/>
    </g>
    <path fill="none" stroke="#e8e8e8" stroke-width="3.5" stroke-linecap="round" d="M 440,162 C 452,170 466,178 494,186"/>
  </g>
