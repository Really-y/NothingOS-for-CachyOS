{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/nothing-logo.txt",
    "color": {
      "1": "38;2;255;255;255",
      "2": "38;2;58;58;58",
      "3": "38;2;215;25;33"
    },
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;142;142;142",
      "output": "38;2;255;255;255",
      "separator": "38;2;94;94;94"
    },
    "key": {
      "width": 10
    },
    "percent": {
      "type": 1,
      "green": "38;2;255;255;255",
      "yellow": "38;2;255;255;255",
      "red": "38;2;215;25;33"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": {
        "user": "38;2;255;255;255",
        "at": "38;2;94;94;94",
        "host": "38;2;255;255;255"
      }
    },
    {
      "type": "custom",
      "format": "· · · · · · · · · · · · · · · · · · ·",
      "outputColor": "38;2;42;42;42"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "host",
      "key": "DEVICE"
    },
    {
      "type": "kernel",
      "key": "KERNEL"
    },
    {
      "type": "uptime",
      "key": "UPTIME"
    },
    {
      "type": "packages",
      "key": "PACKAGES",
      "format": "{pacman} pacman"
    },
    {
      "type": "shell",
      "key": "SHELL"
    },
    {
      "type": "de",
      "key": "DESKTOP"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "terminal",
      "key": "TERMINAL"
    },
    {
      "type": "terminalfont",
      "key": "FONT"
    },
    {
      "type": "custom",
      "format": "· · · · · · · · · · · · · · · · · · ·",
      "outputColor": "38;2;42;42;42"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "MEMORY"
    },
    {
      "type": "disk",
      "key": "DISK",
      "folders": "/"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;26;26;26m●\u001b[0m \u001b[38;2;215;25;33m●\u001b[0m \u001b[38;2;143;181;154m●\u001b[0m \u001b[38;2;201;185;138m●\u001b[0m \u001b[38;2;138;155;181m●\u001b[0m \u001b[38;2;169;148;181m●\u001b[0m \u001b[38;2;134;174;176m●\u001b[0m \u001b[38;2;200;200;200m●\u001b[0m \u001b[38;2;94;94;94m●\u001b[0m \u001b[38;2;255;59;68m●\u001b[0m \u001b[38;2;180;212;187m●\u001b[0m \u001b[38;2;224;211;168m●\u001b[0m \u001b[38;2;174;187;209m●\u001b[0m \u001b[38;2;198;182;209m●\u001b[0m \u001b[38;2;170;205;207m●\u001b[0m \u001b[38;2;255;255;255m●\u001b[0m"
    },
    "break"
  ]
}
