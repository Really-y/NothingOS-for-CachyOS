frame.bottom=6
frame.left=6
frame.right=6
frame.expansion=64
text.press.color=#ffffff
text.toggle.color=#ffffff
text.margin.top=2
text.margin.bottom=2
text.margin.left=8
text.margin.right=8

[ToolbarLineEdit]
inherits=LineEdit

[DropDownButton]
inherits=PanelButtonCommand
