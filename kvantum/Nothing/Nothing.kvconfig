[%General]
author=NothingOS for CachyOS
comment=Nothing OS for Qt Widgets: pure black, flat pills, white selection, dot controls
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
center_doc_tabs=false
center_normal_tabs=false
attach_active_tab=false
mirror_doc_tabs=false
joined_inactive_tabs=false
no_inactive_tab_expansion=true
group_toolbar_buttons=false
toolbar_item_spacing=4
toolbar_interior_spacing=6
toolbar_separator_thickness=0
slim_toolbars=false
spread_progressbar=true
spread_menuitems=false
spread_header=true
composite=true
translucent_windows=false
blurring=false
popup_blurring=false
menu_shadow_depth=0
tooltip_shadow_depth=0
shadowless_popup=true
menu_separator_height=9
splitter_width=6
scroll_width=8
scroll_arrows=false
scroll_min_extent=48
center_scrollbar_indicator=false
transient_scrollbar=false
transient_groove=false
scrollbar_in_view=true
slider_width=8
slider_handle_width=22
slider_handle_length=22
tickless_slider_handle_size=22
check_size=20
textless_progressbar=false
progressbar_thickness=12
menubar_mouse_tracking=true
toolbutton_style=0
double_click=false
fill_rubberband=true
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
combo_as_lineedit=true
square_combo_button=false
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=false
groupbox_top_label=true
inline_spin_indicators=true
inline_spin_separator=false
vertical_spin_indicators=false
spin_button_width=24
animate_states=true
button_contents_shift=false
layout_spacing=6
layout_margin=8
submenu_overlap=0
submenu_delay=150
tooltip_delay=-1
tree_branch_line=false
no_window_pattern=true
respect_DE=true
dialog_button_layout=0
reduce_window_opacity=0
reduce_menu_opacity=0
scrollable_menu=false
click_behavior=0
contrast=1.00
intensity=1.00
saturation=1.00
bold_active_tab=false
remove_extra_frames=true
drag_from_buttons=false

[GeneralColors]
window.color=#000000
base.color=#000000
alt.base.color=#0a0a0a
button.color=#1a1a1a
light.color=#2a2a2a
mid.light.color=#262626
dark.color=#000000
mid.color=#111111
shadow.color=#000000
highlight.color=#ffffff
inactive.highlight.color=#e6e6e6
text.color=#ffffff
window.text.color=#ffffff
button.text.color=#ffffff
disabled.text.color=#5e5e5e
tooltip.base.color=#1a1a1a
tooltip.text.color=#ffffff
highlight.text.color=#000000
inactive.highlight.text.color=#000000
link.color=#d71921
link.visited.color=#8e8e8e
progress.indicator.text.color=#ffffff
progress.inactive.indicator.text.color=#ffffff

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=true
transparent_pcmanfm_sidepane=true
transparent_pcmanfm_view=true
transparent_menutitle=true
transparent_arrow_button=true
respect_darkness=true
kcapacitybar_as_progressbar=true
force_size_grip=false
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=50
normal_default_pushbutton=false
single_top_toolbar=true
tint_on_mouseover=0
no_selection_tint=true
middle_click_scroll=false
centered_forms=false
style_vertical_toolbars=false
blur_translucent=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
frame.expansion=64
interior=true
interior.element=button
indicator.element=arrow
indicator.size=14
text.normal.color=#ffffff
text.focus.color=#ffffff
text.press.color=#000000
text.toggle.color=#000000
text.disabled.color=#5e5e5e
text.shadow=0
text.margin.top=2
text.margin.bottom=2
text.margin.left=12
text.margin.right=12
text.iconspacing=6
min_width=+2font
min_height=0

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
indicator.element=tarrow
text.press.color=#ffffff
text.toggle.color=#ffffff
text.margin.left=6
text.margin.right=6
min_width=0
min_height=0

[ToolbarButton]
inherits=PanelButtonTool
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
frame.expansion=64
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4

[Dock]
inherits=PanelButtonCommand
frame.element=dock
interior.element=dock
frame.expansion=0
text.normal.color=#8e8e8e

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#8e8e8e
text.focus.color=#8e8e8e
text.bold=false

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=tbutton
interior.element=tbutton
frame.expansion=64
indicator.element=spin
indicator.size=14
text.press.color=#ffffff
text.toggle.color=#ffffff

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.press.color=#ffffff
text.toggle.color=#ffffff
text.margin.left=4
text.margin.right=4
min_width=0
min_height=0

[CheckBox]
inherits=RadioButton
interior.element=checkbox

[Focus]
frame=false
interior=false

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.expansion=0
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
