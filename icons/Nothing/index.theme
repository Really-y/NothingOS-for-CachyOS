[Icon Theme]
Name=Nothing
Comment=Monochrome Nothing places and app icons on top of Papirus-Dark
Inherits=Papirus-Dark,breeze-dark,hicolor
Example=folder
Directories=scalable/places,scalable/apps

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications
