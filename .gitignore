# shared UI kit copied into each plasmoid by scripts/build-plasmoids.sh
plasma/plasmoids/*/contents/ui/nothing/
# shared kit copied into the lock screen, and the lock screen copied into the shell carrier package
# by plasma/lookandfeel/install.sh
plasma/lookandfeel/org.nothing.desktop/contents/lockscreen/nothing/
plasma/shells/org.nothing.desktop/contents/

# per-machine app icons generated by icons/gen_icons.py (appicons.py) at install time
icons/Nothing/scalable/apps/
icons/Nothing/glyphmap.json
__pycache__/
icons/Nothing/22/
icons/Nothing/48/
icons/Nothing/16/
icons/Nothing/scalable/mimetypes/
icons/Nothing/scalable/devices/
